hes":[]}}},"disposition":"document","zones":{"fenetre.titre":[{"type":"ligne","id":"titre","ton":"neutre","texte":"On recherche ! Aventuriers courageux !","detail":null,"touche":null}],"fenetre.etape":[],"fenetre.corps":[{"type":"ligne","id":"lecture","ton":"neutre","texte":"*Son Excellence le Prince Héritier Hergard von Tasseninck de la Grande Principauté d'Ostland, fait savoir par la présente qu'il réside actuellement à Altdorf et souhaite s'attacher les services d'un groupe d'aventuriers chevronnés. L'engagement prendra effet dès que possible, pour une période indéterminée.*\n\n*Que les postulants soient avisés qu'il leur sera demandé d'entreprendre une mission des plus périlleuses dans les régions inexplorées des Montagnes Grises. L'objet de la mission est très délicat et la plus haute discrétion est impérative en ce qui concerne sa nature précise.*\n\n*La rémunération est négociable et dépendra de l'expérience des candidats, mais un minimum de 8 Couronnes par personne et par jour est assuré. De plus, une prime généreuse sera accordée une fois la mission accomplie. Couards, traînards et nains s'abstenir.*\n\n*Signé*\n\n*Scribe personnel du Prince Héritier Hergard*","detail":null,"touche":null}],"fenetre.reglages":[],"fenetre.gestes":[{"type":"bouton","id":"fenetreFermer@document","libelle":"Refermer","jeu":{"type":"fenetreFermer","args":["document"]},"presse":false,"focus":true,"detail":null,"touche":null,"refus":null}],"combat.tour":[],"combat.ordre":[],"combat.actif":[],"combat.avis":[],"combat.apercu":[],"combat.offres":[],"combat.rapides":[],"exploration.gestes":[],"dialogue.orateur":[],"dialogue.replique":[],"dialogue.reponses":[],"journal.titre":[],"groupe.heros":[{"type":"entite","id":"heros/soldat-de-test","ton":"neutre","nom":"Soldat","elements":[{"type":"portrait","id":"portrait","combattant":"soldat-de-test"},{"type":"ligne","id":"carriere","ton":"neutre","texte":"Soldat","detail":null,"touche":null},{"type":"jauge","id":"blessures","ton":"neutre","li